# Next.js development defaults. Copy this file to .env.local.
DJANGO_INTERNAL_ORIGIN=http://127.0.0.1:8001
DJANGO_PUBLIC_ORIGIN=http://127.0.0.1:8001
FORKLUCK_INTERNAL_SECRET=dev-internal-secret
# The Ghost marketing site this app links back to, and where /logout lands.
NEXT_PUBLIC_MARKETING_ORIGIN=https://forkluck.com

# Optional Google Drive invoice picker. These browser-visible values must be
# restricted to the correct origins in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional Google Drive receipts folder. Unlike the three picker values above,
# these must never reach the browser: the key reads every folder shared with
# the service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# How often the Drive watcher polls Google for new receipts. Unset disables it
# and nothing is imported until someone presses "Check now"; one Next process
# polls once for every workspace, so this is not a per-workspace setting.
DRIVE_WATCH_INTERVAL_SECONDS=300
# How many new receipts the watcher reads per workspace per tick.
DRIVE_READ_PER_RUN=5

# Invoice extraction. The default qwen engine bills Forkluck's own QWEN_API_KEY
# below and sends the document to Alibaba Cloud Model Studio's US region, so a
# merchant needs no key of their own. Setting this to anthropic is the opt-in
# alternative: it bills the workspace's own Anthropic key instead.
INVOICE_EXTRACTION_ENGINE=qwen
# Tier 2: the model every file is read with. Defaults to qwen3-vl-flash on the
# qwen engine and claude-opus-5 on anthropic.
INVOICE_EXTRACTION_MODEL=qwen3-vl-flash
# Tier 3: the re-read for a document whose arithmetic or header didn't check
# out, as a model id on the engine above. Unset means a second, better-informed
# read on the same model; empty disables escalation. Left unset here.
# INVOICE_ESCALATION_MODEL=

# Forkluck's own Qwen credential, shared by invoice extraction above and the
# Primo recipe-cost sidekick. This is a server-only credential.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
