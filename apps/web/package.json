{
  "name": "@forkluck/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://forkluck.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forkluck/forkluck.git"
  },
  "bugs": {
    "url": "https://github.com/forkluck/forkluck/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "test": "vitest run",
    "eval:extraction": "tsx --tsconfig scripts/tsconfig.json scripts/eval-extraction.ts",
    "eval:primo": "tsx --tsconfig scripts/tsconfig.json scripts/eval-primo.ts",
    "test:components": "vitest run tests/components",
    "test:acceptance": "playwright test",
    "test:acceptance:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "eval:primo:attachments": "tsx --tsconfig scripts/tsconfig.json scripts/eval-primo-attachments.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@ai-sdk/react": "^4.0.80",
    "@anthropic-ai/sdk": "^0.116.0",
    "@azure/storage-blob": "12.33.0",
    "@base-ui/react": "^1.6.0",
    "@napi-rs/canvas": "^1.0.8",
    "@shadcn/react": "^0.3.0",
    "@shopify/draggable": "^1.2.1",
    "@tanstack/react-table": "^9.1.0",
    "ai": "^7.0.77",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "mammoth": "^1.12.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
