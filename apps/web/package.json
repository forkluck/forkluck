{
  "name": "@forkluck/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://forkluck.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forkluck/forkluck.git"
  },
  "bugs": {
    "url": "https://github.com/forkluck/forkluck/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "test": "vitest run",
    "eval:extraction": "tsx --tsconfig scripts/tsconfig.json scripts/eval-extraction.ts",
    "test:components": "vitest run tests/components",
    "test:acceptance": "playwright test",
    "test:acceptance:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@ai-sdk/react": "^4.0.160",
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/storage-blob": "12.34.0",
    "@base-ui/react": "^1.9.0",
    "@napi-rs/canvas": "^1.0.13",
    "@shadcn/react": "^0.3.1",
    "@shopify/draggable": "^1.2.1",
    "@tanstack/react-table": "^9.3.1",
    "ai": "7.0.156",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.0.5"
  }
