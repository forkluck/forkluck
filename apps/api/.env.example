# Django development defaults. Copy this file to backend/.env.
DJANGO_SECRET_KEY=dev-only-forkluck-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
FORKLUCK_ENVIRONMENT=development
FORKLUCK_ALLOW_DEMO_ACCOUNT=true
FORKLUCK_INTERNAL_SECRET=dev-internal-secret
FORKLUCK_APP_ORIGIN=http://localhost:3000

# Optional Google sign-in: both or neither. Dedicated Web application client.
# Redirect URI: FORKLUCK_APP_ORIGIN + /api/auth/google/callback
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_CLIENT_SECRET=

# Optional Cloudflare Turnstile on sign-up: both or neither. Unset leaves
# sign-up ungated. Cloudflare's test pair always passes for local work:
# TURNSTILE_SITE_KEY=1x00000000000000000000BB
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional private JSON catalog for hosted starter-price estimates. Keep this
# file outside the repository and readable only by the application account.
FORKLUCK_MASTER_PRICE_CATALOG_PATH=

# Optional USDA FoodData Central lookup used to map pantry nutrition.
FDC_API_KEY=

# Leave DATABASE_URL empty to use backend/db.sqlite3.
DATABASE_URL=

# Transactional email is optional in development. Production refuses to start
# without an Azure Communication Services connection string and email
# verification enabled.
ACS_CONNECTION_STRING=
# A bare address: ACS carries the display name on its MailFrom username.
FORKLUCK_EMAIL_FROM=no-reply@localhost
FORKLUCK_REGISTRATION_NOTIFICATION_EMAIL=
# Where a custom nutrition request is announced; left empty the request is still
# stored but nobody is told.
FORKLUCK_SUPPORT_EMAIL=
# Keep false for one-step local signup; production requires true.
FORKLUCK_REQUIRE_EMAIL_VERIFICATION=false
FORKLUCK_ADMIN_CODE_LOGIN=false

# Optional Ghost newsletter sync. Admin API key of a custom integration, as
# `id:secret`; both empty leaves newsletter membership untouched.
GHOST_ADMIN_URL=
GHOST_ADMIN_API_KEY=

# Optional hosted supplier connector service. Supplier credentials belong only
# to that separate deployment; these values authenticate Forkluck itself.
FORKLUCK_CONNECTOR_SERVICE_URL=
FORKLUCK_CONNECTOR_CLIENT_ID=
FORKLUCK_CONNECTOR_CLIENT_SECRET=

# Optional Square and Shopify integrations. Generate the token-encryption key
# with `openssl rand -hex 32` before connecting a real provider account.
FORKLUCK_TOKEN_ENCRYPTION_KEY=
FORKLUCK_TOKEN_ENCRYPTION_KEY_ID=default
FORKLUCK_TOKEN_ENCRYPTION_KEYS=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Optional Stripe subscription billing. All five or none: any partial
# combination refuses to boot in production, and all empty disables billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_ENDPOINT_ID=
