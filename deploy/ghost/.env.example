# Copy to /opt/ghost/.env and chmod 600. Never commit the filled-in file.

# Public URL Ghost renders links against. Use the preview host until cutover:
# GHOST_URL=https://preview.forkluck.com
GHOST_URL=https://forkluck.com
GHOST_MAIL_FROM="Forkluck <noreply@forkluck.com>"

# Azure Communication Services SMTP (from `./deploy/azure/mail.sh smtp`)
ACS_SMTP_USER="forkluck-cs|00000000-0000-0000-0000-000000000000|00000000-0000-0000-0000-000000000000"
ACS_SMTP_PASS=change-me-smtp-secret

# Newsletter bridge (phase 2; only needed once the bridge services are enabled)
BRIDGE_API_KEY=change-me-bridge-api-key
AZURE_COMMUNICATION_CONNECTION_STRING="endpoint=https://forkluck-cs.communication.azure.com/;accesskey=change-me"
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=forkluckmail;AccountKey=change-me;EndpointSuffix=core.windows.net"
