[Unit]
Description=Forkluck durable supplier connector sync worker
After=network.target postgresql.service

[Service]
Type=simple
User=forkluck
Group=forkluck
WorkingDirectory=/opt/forkluck/current/backend
EnvironmentFile=/etc/forkluck/backend.env
ExecStart=/opt/forkluck/shared/venv/bin/python /opt/forkluck/current/backend/manage.py run_connector_sync_worker --poll-interval 2
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=220M

[Install]
WantedBy=multi-user.target
