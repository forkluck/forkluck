@@ -0,0 +1,67 @@
+import React, { useEffect, useState } from "react"
+import "./Footer.scss"
+
+// Mirrors the marketing footer in forkluck-marketing/theme/partials/forkluck-footer.hbs.
+const marketingURL = "https://forkluck.com"
+const appURL = "https://app.forkluck.com"
+const sourceURL = "/static/assets/forkluck-fider-source.tar.gz"
+
+export const Footer = () => {
+  // app.forkluck.com sets forkluck_signed_in=1 on the parent domain, so a
+  // signed-in visitor sees Log out / Dashboard like on the marketing site.
+  const [isSignedIn, setIsSignedIn] = useState(false)
+  useEffect(() => {
+    setIsSignedIn(document.cookie.indexOf("forkluck_signed_in=1") !== -1)
+  }, [])
+
+  return (
+    <footer className="c-footer">
+      <div className="container">
+        <div className="c-footer__cols">
+          <div>
+            <a className="c-footer__wordmark" href={`${marketingURL}/`}>
+              Forkluck
+            </a>
+            <p className="c-footer__blurb">Recipe formulation and costing for working kitchens.</p>
+          </div>
+          <div>
+            <h2>Product</h2>
+            <div className="c-footer__links">
+              <a href={`${marketingURL}/pricing/`}>Pricing</a>
+              <a href="https://github.com/forkluck">Github</a>
+              <a href={`${marketingURL}/changelog/`}>Changelog</a>
+              <a href="/">Ideas</a>
+            </div>
+          </div>
+          <div>
+            <h2>Account</h2>
+            <div className="c-footer__links">
+              {isSignedIn ? (
+                <>
+                  <a href={`${appURL}/logout`}>Log out</a>
+                  <a href={`${appURL}/`}>Dashboard</a>
+                </>
+              ) : (
+                <>
+                  <a href={`${appURL}/login`}>Sign in</a>
+                  <a href={`${appURL}/signup`}>Sign up</a>
+                </>
+              )}
