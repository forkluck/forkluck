+func TestDeleteUserByProvider(t *testing.T) {
+	admin := &entity.User{ID: 100, Role: enum.RoleAdministrator}
+	for _, role := range []enum.Role{enum.RoleVisitor, enum.RoleCollaborator} {
+		status, _ := mock.NewServer().AsUser(&entity.User{ID: 1, Role: role}).Execute(apiv1.DeleteUserByProvider())
+		if status != http.StatusForbidden {
+			t.Fatalf("role %v could delete: %d", role, status)
+		}
+	}
+	deleted := 0
+	bus.AddHandler(func(ctx context.Context, q *query.GetUserByProvider) error {
+		if q.Provider != "_forkluck" || q.UID != "verified-uuid" {
+			t.Fatal("provider identity changed")
+		}
+		q.Result = &entity.User{ID: 42, Role: enum.RoleVisitor}
+		return nil
+	})
+	bus.AddHandler(func(ctx context.Context, c *cmd.DeleteCurrentUser) error {
+		deleted = ctx.Value(app.UserCtxKey).(*entity.User).ID
+		return nil
+	})
+	status, _ := mock.NewServer().AsUser(admin).AddParam("provider", "_forkluck").AddParam("uid", "verified-uuid").Execute(apiv1.DeleteUserByProvider())
+	if status != http.StatusOK || deleted != 42 {
+		t.Fatalf("delete: status=%d user=%d", status, deleted)
+	}
+	bus.AddHandler(func(ctx context.Context, q *query.GetUserByProvider) error {
+		return errors.Wrap(app.ErrNotFound, "missing")
+	})
+	status, _ = mock.NewServer().AsUser(admin).Execute(apiv1.DeleteUserByProvider())
+	if status != http.StatusOK {
+		t.Fatalf("retry: %d", status)
+	}
+	bus.AddHandler(func(ctx context.Context, q *query.GetUserByProvider) error { q.Result = admin; return nil })
+	status, _ = mock.NewServer().AsUser(admin).Execute(apiv1.DeleteUserByProvider())
+	if status != http.StatusForbidden {
+		t.Fatalf("service deleted itself: %d", status)
+	}
+}
