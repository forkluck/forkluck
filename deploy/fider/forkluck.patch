@@ -12,6 +12,32 @@ import (
 	"github.com/getfider/fider/app/pkg/web"
 )
 
+// DeleteUserByProvider lets the owning identity service erase its linked user.
+// The route is administrator-only; lookup remains scoped to this board.
+func DeleteUserByProvider() web.HandlerFunc {
+	return func(c *web.Context) error {
+		if !c.IsAuthenticated() || c.User().Role != enum.RoleAdministrator {
+			return c.Forbidden()
+		}
+		lookup := &query.GetUserByProvider{Provider: c.Param("provider"), UID: c.Param("uid")}
+		if err := bus.Dispatch(c, lookup); err != nil {
+			if errors.Cause(err) == app.ErrNotFound {
+				return c.Ok(web.Map{})
+			}
+			return c.Failure(err)
+		}
+		// The service account must remain available to process future deletes.
+		if lookup.Result.ID == c.User().ID {
+			return c.Forbidden()
+		}
+		c.SetUser(lookup.Result)
+		if err := bus.Dispatch(c, &cmd.DeleteCurrentUser{}); err != nil {
+			return c.Failure(err)
+		}
+		return c.Ok(web.Map{})
+	}
+}
