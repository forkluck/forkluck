# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/apps/web/coverage
/apps/web/.playwright-cli/
/output/
/apps/web/output/

# next.js
/apps/web/.next/
/apps/web/.next-acceptance/
/apps/web/out/

# python / django
/.uv-cache/
# No trailing slash: a worktree gets its toolchain by symlinking this path,
# and a directory-only rule leaves the symlink committable.
/apps/api/.venv
/services/connectors/.venv
/skills/.venv
/apps/api/db.sqlite3
/services/connectors/db.sqlite3
/apps/api/db.sqlite3-*
/services/connectors/db.sqlite3-*
/apps/api/staticfiles/
/services/connectors/staticfiles/
/apps/api/private/
__pycache__/
*.py[cod]
.pytest_cache/

# production
/apps/web/build

# private Catalog data; code is public, product rows and mappings are not
/artifacts/ingredient-mapping/

# local API research; contains authenticated catalog and recipe response data
/research/

# stored invoice documents, when the disk backend is in use
/.forkluck/
/apps/web/.forkluck/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# generated AI context bundle
/repomix-output.xml

# env files; checked-in examples must never contain real credentials
.env*
!**/.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# design-sync machine state (staged scripts, build output, caches)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Ghost local preview: container content and per-target image URL caches

# Claude Code local state and worktrees
.claude/
