# Copy to .env. config/settings.py reads it in development, never in production.
# Values are read literally: no shell quoting.
CONNECTORS_ENVIRONMENT=development
CONNECTORS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Must match FORKLUCK_CONNECTOR_SERVICE_URL in apps/api/.env.
CONNECTORS_PUBLIC_BASE_URL=http://localhost:8010
# `pnpm connectors:setup` fills this in once. Keep it: credentials stored
# locally are unreadable without it.
CONNECTORS_ENCRYPTION_KEY=
# Development opens Baldor to every local user. Production requires explicit
# Forkluck user UUIDs; see docs/OPERATIONS.md.
CONNECTORS_PROVIDER_ALLOWLIST={"baldor":["*"]}
# Unset uses a local SQLite file. Production requires a dedicated PostgreSQL DB.
# CONNECTORS_DATABASE_URL=postgresql://connectors:connectors@localhost:5432/connectors
