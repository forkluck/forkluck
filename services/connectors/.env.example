# Local shell configuration: source this file after copying it to .env.
# config/settings.py reads environment variables; it does not load .env itself.
CONNECTORS_ENVIRONMENT=development
CONNECTORS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CONNECTORS_PUBLIC_BASE_URL=http://localhost:8010
# Generate a value with: python3 -c 'import secrets; print(secrets.token_hex(32))'
CONNECTORS_ENCRYPTION_KEY=
# Add authenticated Forkluck user UUIDs when testing a real provider locally.
CONNECTORS_PROVIDER_ALLOWLIST='{}'
# Unset uses a local SQLite file. Production requires a dedicated PostgreSQL DB.
# CONNECTORS_DATABASE_URL=postgresql://connectors:connectors@localhost:5432/connectors
